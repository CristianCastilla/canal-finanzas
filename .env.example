# Copia este archivo a .env solo para probar en local.
# En GitHub se configuran como Secrets del repositorio.

# Obligatorio para generar guiones (una de las dos)
GEMINI_API_KEY=
GROQ_API_KEY=

# Obligatorio para publicar. Es el JSON que imprime scripts/auth_youtube.py
YOUTUBE_TOKEN_JSON=

# Opcional: imágenes sin límite de 1/45 s y sin marca de agua
POLLINATIONS_TOKEN=

# Opcional: avisos por Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
